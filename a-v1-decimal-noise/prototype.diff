diff --git i/src/values/__init__.py w/src/values/__init__.py
index 06af60b..f2b92a8 100644
--- i/src/values/__init__.py
+++ w/src/values/__init__.py
@@ -265,3 +265,29 @@ def compare(a, b):
     x = 1.0 if a.value is True else 0.0 if a.value is False else a.value
     y = 1.0 if b.value is True else 0.0 if b.value is False else b.value
     return _sign(x, y)
+
+
+# LibreOffice's rtl::math approximate arithmetic: two doubles within 2**-48 of each other (relative) are equal,
+# and adding opposites / subtracting near-equals gives exactly 0.
+_E48 = 2.0 ** -48
+
+
+def approx_equal(a, b):
+    if a == b:
+        return True
+    if a == 0.0 or b == 0.0:
+        return False
+    d = abs(a - b)
+    return d < abs(a) * _E48 and d < abs(b) * _E48
+
+
+def approx_add(a, b):
+    if ((a < 0.0 < b) or (b < 0.0 < a)) and approx_equal(a, -b):
+        return 0.0
+    return a + b
+
+
+def approx_sub(a, b):
+    if ((a < 0.0 and b < 0.0) or (a > 0.0 and b > 0.0)) and approx_equal(a, b):
+        return 0.0
+    return a - b
