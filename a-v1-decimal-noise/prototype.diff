+def _reported(v):
+    """Numbers as Calc reports them: 15 significant digits, so 0.1+0.2 prints 0.3, not binary noise."""
+    if isinstance(v, float):
+        return float(f"{v:.15g}")
+    if isinstance(v, dict):
+        return {k: _reported(x) for k, x in v.items()}
+    return v
+
