diff --git i/src/eval/__init__.py w/src/eval/__init__.py
index c65fa18..792071e 100644
--- i/src/eval/__init__.py
+++ w/src/eval/__init__.py
@@ -225,9 +225,16 @@ def _eval(node, book, sheet):
         v = to_number(_scalar(_eval(node.operand, book, sheet)))
         return v if isinstance(v, Error) else _num(v.value / 100.0)
     if isinstance(node, p.Binary):
-        left = _scalar(_eval(node.left, book, sheet))
-        right = _scalar(_eval(node.right, book, sheet))
-        return _binary(node.op, left, right)
+        # A long chain such as =1+1+...+1 is a left-deep tree: walk its left spine with a loop, then fold
+        # left to right (Calc's order), so its length is not limited by Python's recursion.
+        spine = []
+        while isinstance(node, p.Binary):
+            spine.append(node)
+            node = node.left
+        acc = _scalar(_eval(node, book, sheet))
+        for b in reversed(spine):
+            acc = _binary(b.op, acc, _scalar(_eval(b.right, book, sheet)))
+        return acc
     return VALUE
 
 
