+        return _read(sys.stdin, "the input")
+    try:
+        with open(path, encoding="utf-8") as f:
+            return _read(f, path)
+    except FileNotFoundError:
+        raise BadInput(f"no such file: {path}") from None
+    except IsADirectoryError:
+        raise BadInput(f"is a directory, not a file: {path}") from None
+    except (OSError, UnicodeDecodeError) as e:
+        raise BadInput(f"cannot read {path}: {getattr(e, 'strerror', None) or e}") from None
+
+
+def _cell_key(key):
+    m = CELL.match(key)
+    return (m.group(1).upper() + m.group(2)) if m else key
+
+
+def check(book):
+    """The workbook with cell keys upper-cased; BadInput if it is not SPEC's shape."""
+    if not isinstance(book, dict) or not isinstance(book.get("sheets"), dict):
+        raise BadInput('not a workbook: expected {"sheets": {"Sheet1": {...}}}')
+    sheets = {}
+    for name, cells in book["sheets"].items():
+        if not isinstance(cells, dict):
+            raise BadInput(f"not a workbook: sheet {name!r} is not an object of cells")
+        out = {}
+        for key, v in cells.items():
+            if isinstance(v, list) or (isinstance(v, dict) and set(v) != {"error"}):
+                raise BadInput(f"not a workbook: cell {name}!{key} holds {json.dumps(v)[:40]}")
+            k = _cell_key(key)
+            if k in out:
+                raise BadInput(f"not a workbook: cell {name}!{k} is given twice")
+            out[k] = v
+        sheets[name] = out
+    return {**book, "sheets": sheets}
 
 
