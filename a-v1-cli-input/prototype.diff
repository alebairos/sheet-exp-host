 """The engine CLI: ``engine <file|-> [--cell Sheet!A1]`` (SPEC.md)."""
 
 import json
+import math
+import re
 import sys
 
 from src.recalc import compute as recalc
 
+CELL = re.compile(r"^\$?([A-Za-z]+)\$?([1-9][0-9]*)$")
+
+
+class BadInput(Exception):
+    """Input the engine refuses, with a message for the user."""
+
+
+def _no_constant(name):
+    raise BadInput(f"not a JSON number: {name}")
+
+
+def _number(text):
+    x = float(text)
+    if not math.isfinite(x):
+        raise BadInput(f"number out of range: {text}")
+    return int(x) if x.is_integer() and abs(x) < 2 ** 53 else x
+
+
+def _read(f, name):
+    try:
+        return json.load(f, parse_constant=_no_constant, parse_float=_number)
+    except json.JSONDecodeError as e:
+        raise BadInput(f"{name} is not valid JSON: {e.msg} at line {e.lineno} column {e.colno}") from None
+
 
 def load(path):
